# Reachy Personal Assistant - Environment Variables
# Copy this to .env and fill in your values

# ============================================
# Required
# ============================================

# ElevenLabs for text-to-speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Hugging Face for model downloads
HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here

# Daily.co for WebRTC (get from https://dashboard.daily.co)
DAILY_API_KEY=your_daily_api_key_here
DAILY_ROOM_URL=https://your-domain.daily.co/your-room

# ============================================
# Local Models (Docker)
# ============================================

# These are set automatically by docker-compose
# Override only if running models elsewhere
# MAIN_MODEL_URL=http://localhost:8002/v1
# ROUTER_MODEL_URL=http://localhost:8003/v1

# ============================================
# Cloud APIs (Optional - alternative to local)
# ============================================

# OpenAI API (if using GPT models)
# OPENAI_API_KEY=your_openai_key_here

# NVIDIA NIM API (if using cloud inference)
# NVIDIA_API_KEY=your_nvidia_api_key_here

# ============================================
# Soul System
# ============================================

# How often the soul loop runs (milliseconds)
SOUL_POLL_INTERVAL_MS=200

# Enable idle behaviors (breathing, micro-movements)
SOUL_ENABLE_IDLE=true

# Enable verbose soul logging
SOUL_DEBUG_LOGGING=false

# ============================================
# MCP Integrations (Optional)
# ============================================

# Google Calendar/Gmail
# GOOGLE_OAUTH_TOKEN=your_google_token_here

# GitHub
# GITHUB_TOKEN=your_github_token_here
